import Foundation
import UIKit
import UniformTypeIdentifiers
import SwiftUI

// MARK: - Import Compatibility Models
// macOS Compatibility Models are defined in the same module, so no import needed

/// 基于文件的 iCloud 同步服务 - 与 macOS AssetManager 兼容
@MainActor
class FileBasediCloudSyncService: NSObject, ObservableObject {
    // MARK: - Properties
    @Published var syncFolderPath: String?
    @Published var isSyncEnabled = false
    @Published var syncStatus = "未连接到 iCloud"
    @Published var syncProgress: Double = 0.0
    
    private let fileManager = FileManager.default
    private var ubiquityContainer: URL?
    var selectedFolderURL: URL?
    
    private var bookmarkData: Data?
    
    // 文件名常量
    private let assetsFileName = "assets.json"
    private let recordsFileName = "records.json"
    private let sourcesFileName = "sources.json"
    
    override init() {
        super.init()
        setupiCloudContainer()
        loadSyncFolderPath()
        
        // 尝试从书签恢复 URL
        if let restoredURL = restoreURLFromBookmark() {
            selectedFolderURL = restoredURL
            syncStatus = "已恢复同步文件夹: \(restoredURL.lastPathComponent)"
        }
    }
    
    // MARK: - Setup
    
    private func setupiCloudContainer() {
        // 尝试设置 iCloud 容器，但即使失败也不影响文件夹选择功能
        if let containerURL = fileManager.url(forUbiquityContainerIdentifier: nil) {
            ubiquityContainer = containerURL
            syncStatus = "iCloud 已连接"
            isSyncEnabled = true
        } else {
            syncStatus = "iCloud 容器不可用，但仍可选择其他文件夹进行同步"
            isSyncEnabled = false  // 只是表示iCloud容器不可用，不影响文件夹选择
        }
    }
    
    // MARK: - Folder Selection
    
    /// 通过 UIDocumentPickerViewController 选择同步文件夹
    func selectSyncFolder() {
        DispatchQueue.main.async {
            let documentPicker = UIDocumentPickerViewController(forOpeningContentTypes: [.folder], asCopy: false)
            documentPicker.delegate = self
            documentPicker.allowsMultipleSelection = false
            
            if let rootVC = UIApplication.shared.windows.first?.rootViewController {
                rootVC.present(documentPicker, animated: true)
            }
        }
    }
    
    // MARK: - Data Operations
    
    /// 将数据同步到选定的文件夹
    func syncToiCloud(assets: [Asset], records: [OperationRecord], sources: [AssetSource]) async -> Bool {
        guard let folderURL = selectedFolderURL else {
            syncStatus = "未选择同步文件夹"
            return false
        }
        
        #if os(macOS)
        // 确保有访问权限（仅在 macOS 上需要）
        let accessGranted = folderURL.startAccessingSecurityScopedResource()
        defer {
            if accessGranted {
                folderURL.stopAccessingSecurityScopedResource()
            }
        }
        #endif
        
        do {
            syncStatus = "正在同步到本地文件夹..."
            syncProgress = 0.0
            
            // 1. 写入 assets.json
            let assetsData = try JSONEncoder().encode(assets)
            let assetsFileURL = folderURL.appendingPathComponent(assetsFileName)
            try assetsData.write(to: assetsFileURL)
            
            syncProgress = 0.33
            syncStatus = "正在同步操作记录..."
            
            // 2. 写入 records.json
            let recordsData = try JSONEncoder().encode(records)
            let recordsFileURL = folderURL.appendingPathComponent(recordsFileName)
            try recordsData.write(to: recordsFileURL)
            
            syncProgress = 0.66
            syncStatus = "正在同步来源信息..."
            
            // 3. 写入 sources.json
            let sourcesData = try JSONEncoder().encode(sources)
            let sourcesFileURL = folderURL.appendingPathComponent(sourcesFileName)
            try sourcesData.write(to: sourcesFileURL)
            
            syncProgress = 1.0
            syncStatus = "同步完成 (\(Date.now.formatted(date: .numeric, time: .shortened)))"
            
            return true
        } catch {
            syncStatus = "同步失败: \(error.localizedDescription)"
            syncProgress = 0.0
            return false
        }
    }
    
    /// 从选定的文件夹同步数据
    func syncFromiCloud() async throws -> (assets: [Asset], records: [OperationRecord], sources: [AssetSource]) {
        guard let folderURL = selectedFolderURL else {
            syncStatus = "未选择同步文件夹"
            throw NSError(domain: "FileBasediCloudSync", code: -1, userInfo: [NSLocalizedDescriptionKey: "未选择同步文件夹"])
        }
        
        print("✅ syncFromiCloud() 开始执行")
        print("📁 selectedFolderURL.path: \(folderURL.path)")
        print("📁 assetsFileName: \(assetsFileName)")
        print("📁 recordsFileName: \(recordsFileName)")
        print("📁 sourcesFileName: \(sourcesFileName)")
        
        // 检查文件夹是否存在
        let folderExists = fileManager.fileExists(atPath: folderURL.path)
        print("📁 文件夹存在: \(folderExists)")
        
        if folderExists {
            do {
                let contents = try fileManager.contentsOfDirectory(atPath: folderURL.path)
                print("📋 文件夹内容: \(contents)")
            } catch {
                print("❌ 无法读取文件夹内容: \(error)")
            }
        }
        
        #if os(macOS)
        // 确保有访问权限（仅在 macOS 上需要）
        let accessGranted = folderURL.startAccessingSecurityScopedResource()
        defer {
            if accessGranted {
                folderURL.stopAccessingSecurityScopedResource()
            }
        }
        #endif
        
        do {
            syncStatus = "正在从本地文件夹同步..."
            syncProgress = 0.0
            
            let decoder = JSONDecoder()
            decoder.dateDecodingStrategy = .iso8601
            
            // 1. 读取 assets.json - 先尝试 macOS 格式，再尝试 iOS 格式
            let assetsFileURL = folderURL.appendingPathComponent(assetsFileName)
            print("🔍 检查 assets 文件: \(assetsFileURL.path)")
            var assets: [Asset] = []
            if fileManager.fileExists(atPath: assetsFileURL.path) {
                print("✅ assets.json 文件存在")
                let assetsData = try Data(contentsOf: assetsFileURL)
                print("📊 assets.json 文件大小: \(assetsData.count) 字节")
                
                // 打印 JSON 前 200 个字符用于调试
                if let jsonString = String(data: assetsData, encoding: .utf8) {
                    let previewLength = min(200, jsonString.count)
                    let previewEndIndex = jsonString.index(jsonString.startIndex, offsetBy: previewLength)
                    let preview = String(jsonString[..<previewEndIndex])
                    print("🔍 JSON 内容预览: \(preview)")
                }
            } else {
                print("❌ assets.json 文件不存在")
            }
                let assetsData = try Data(contentsOf: assetsFileURL)
                print("✅ 开始解析 assets.json，大小: \(assetsData.count) 字节")
                
                do {
                    // 尝试 macOS 格式
                    let macAssets = try decoder.decode([MacOSAsset].self, from: assetsData)
                    print("✅ 成功解析为 macOS 格式的 assets (\(macAssets.count) 个项目)")
                    assets = macAssets.map { macAsset in
                        Asset(
                            fromDict: [
                                "id": macAsset.id,
                                "assetName": macAsset.assetName,
                                "modelName": macAsset.modelName,
                                "brand": macAsset.brand,
                                "status": macAsset.status.rawValue,
                                "internalCode": macAsset.internalCode,
                                "location": macAsset.location,
                                "purchaseDate": macAsset.purchaseDate?.ISO8601Format() ?? "",
                                "note": macAsset.note ?? "",
                                "lastUpdated": macAsset.lastUpdated.ISO8601Format(),
                                "sourceId": macAsset.sourceId?.uuidString ?? ""
                            ],
                            sourceId: macAsset.sourceId
                        )!
                    }
                } catch let decodeError {
                    print("⚠️ 解析 macOS 格式失败: \(decodeError)")
                    do {
                        // 回退到 iOS 格式
                        assets = try decoder.decode([Asset].self, from: assetsData)
                        print("✅ 成功解析为 iOS 格式的 assets (\(assets.count) 个项目)")
                    } catch let iosDecodeError {
                        print("❌ 解析 iOS 格式也失败: \(iosDecodeError)")
                        throw NSError(domain: "JSONDecodeError", code: -2, userInfo: [NSLocalizedDescriptionKey: "解析 assets.json 失败: \(iosDecodeError.localizedDescription)"])
                    }
                }
            } else {
                print("ℹ️ assets.json 文件不存在，跳过")
            }
            
            syncProgress = 0.33
            syncStatus = "正在加载操作记录..."
            
            // 2. 读取 records.json - 同样处理
            let recordsFileURL = folderURL.appendingPathComponent(recordsFileName)
            print("🔍 检查 records 文件: \(recordsFileURL.path)")
            var records: [OperationRecord] = []
            if fileManager.fileExists(atPath: recordsFileURL.path) {
                print("✅ records.json 文件存在")
                let recordsData = try Data(contentsOf: recordsFileURL)
                print("📊 records.json 文件大小: \(recordsData.count) 字节")
                
                // 打印 JSON 前 200 个字符用于调试
                if let jsonString = String(data: recordsData, encoding: .utf8) {
                    let previewLength = min(200, jsonString.count)
                    let previewEndIndex = jsonString.index(jsonString.startIndex, offsetBy: previewLength)
                    let preview = String(jsonString[..<previewEndIndex])
                    print("🔍 JSON 内容预览: \(preview)")
                }
            } else {
                print("❌ records.json 文件不存在")
            }
                let recordsData = try Data(contentsOf: recordsFileURL)
                print("✅ 开始解析 records.json，大小: \(recordsData.count) 字节")
                
                do {
                    let macRecords = try decoder.decode([MacOSOperationRecord].self, from: recordsData)
                    print("✅ 成功解析为 macOS 格式的 records (\(macRecords.count) 个项目)")
                    records = macRecords.map { macRecord in
                        OperationRecord(
                            id: macRecord.id,
                            assetId: macRecord.assetId,
                            assetName: macRecord.assetName,
                            type: OperationType(rawValue: macRecord.type.rawValue) ?? .checkIn,
                            operator: macRecord.operatorName,
                            timestamp: macRecord.timestamp,
                            note: macRecord.note,
                            estimatedReturnDate: macRecord.estimatedReturnDate,
                            isSyncedToReminders: macRecord.isSyncedToReminders
                        )
                    }
                } catch let recordDecodeError {
                    print("⚠️ 解析 macOS 格式 records 失败: \(recordDecodeError)")
                    do {
                        records = try decoder.decode([OperationRecord].self, from: recordsData)
                        print("✅ 成功解析为 iOS 格式的 records (\(records.count) 个项目)")
                    } catch let iosRecordDecodeError {
                        print("❌ 解析 iOS 格式 records 也失败: \(iosRecordDecodeError)")
                        throw NSError(domain: "JSONDecodeError", code: -3, userInfo: [NSLocalizedDescriptionKey: "解析 records.json 失败: \(iosRecordDecodeError.localizedDescription)"])
                    }
                }
            } else {
                print("ℹ️ records.json 文件不存在，跳过")
            }
            
            syncProgress = 0.66
            syncStatus = "正在加载来源信息..."
            
            // 3. 读取 sources.json - 同样处理
            let sourcesFileURL = folderURL.appendingPathComponent(sourcesFileName)
            print("🔍 检查 sources 文件: \(sourcesFileURL.path)")
            var sources: [AssetSource] = []
            if fileManager.fileExists(atPath: sourcesFileURL.path) {
                print("✅ sources.json 文件存在")
                let sourcesData = try Data(contentsOf: sourcesFileURL)
                print("📊 sources.json 文件大小: \(sourcesData.count) 字节")
                
                // 打印 JSON 前 200 个字符用于调试
                if let jsonString = String(data: sourcesData, encoding: .utf8) {
                    let previewLength = min(200, jsonString.count)
                    let previewEndIndex = jsonString.index(jsonString.startIndex, offsetBy: previewLength)
                    let preview = String(jsonString[..<previewEndIndex])
                    print("🔍 JSON 内容预览: \(preview)")
                }
            } else {
                print("❌ sources.json 文件不存在")
            }
                let sourcesData = try Data(contentsOf: sourcesFileURL)
                print("✅ 开始解析 sources.json，大小: \(sourcesData.count) 字节")
                
                do {
                    let macSources = try decoder.decode([MacOSAssetSource].self, from: sourcesData)
                    print("✅ 成功解析为 macOS 格式的 sources (\(macSources.count) 个项目)")
                    sources = macSources.map { macSource in
                        AssetSource(
                            id: macSource.id,
                            fileName: macSource.fileName,
                            importDate: macSource.importDate,
                            assetCount: macSource.assetCount
                        )
                    }
                } catch let sourceDecodeError {
                    print("⚠️ 解析 macOS 格式 sources 失败: \(sourceDecodeError)")
                    do {
                        sources = try decoder.decode([AssetSource].self, from: sourcesData)
                        print("✅ 成功解析为 iOS 格式的 sources (\(sources.count) 个项目)")
                    } catch let iosSourceDecodeError {
                        print("❌ 解析 iOS 格式 sources 也失败: \(iosSourceDecodeError)")
                        throw NSError(domain: "JSONDecodeError", code: -4, userInfo: [NSLocalizedDescriptionKey: "解析 sources.json 失败: \(iosSourceDecodeError.localizedDescription)"])
                    }
                }
            } else {
                print("ℹ️ sources.json 文件不存在，跳过")
            }
            
            syncProgress = 1.0
            syncStatus = "同步完成 (\(Date.now.formatted(date: .numeric, time: .shortened)))"
            
            print("✅ 同步完成，共加载 \(assets.count) 个资产, \(records.count) 条记录, \(sources.count) 个来源")
            return (assets, records, sources)
        } catch {
            syncStatus = "同步失败: \(error.localizedDescription)"
            syncProgress = 0.0
            print("❌ 同步失败: \(error)")
            throw error
        }
    }
    
    /// 双向同步 - 合并策略
    func bidirectionalSync(localAssets: [Asset], localRecords: [OperationRecord], localSources: [AssetSource]) async throws -> (assets: [Asset], records: [OperationRecord], sources: [AssetSource]) {
        guard let folderURL = selectedFolderURL else {
            syncStatus = "未选择同步文件夹"
            throw NSError(domain: "FileBasediCloudSync", code: -1, userInfo: [NSLocalizedDescriptionKey: "未选择同步文件夹"])
        }
        
        #if os(macOS)
        // 确保有访问权限（仅在 macOS 上需要）
        let accessGranted = folderURL.startAccessingSecurityScopedResource()
        defer {
            if accessGranted {
                folderURL.stopAccessingSecurityScopedResource()
            }
        }
        #endif
        
        // 1. 从 iCloud 获取远程数据
        let (remoteAssets, remoteRecords, remoteSources) = try await syncFromiCloud()
        
        // 2. 合并数据
        let mergedResult = mergeLocalAndRemote(
            localAssets: localAssets,
            localRecords: localRecords,
            localSources: localSources,
            remoteAssets: remoteAssets,
            remoteRecords: remoteRecords,
            remoteSources: remoteSources
        )
        
        // 3. 将合并后的数据同步回 iCloud
        _ = await syncToiCloud(
            assets: mergedResult.assets,
            records: mergedResult.records,
            sources: mergedResult.sources
        )
        
        return mergedResult
    }
    
    // MARK: - Data Merging
    
    private func mergeLocalAndRemote(
        localAssets: [Asset],
        localRecords: [OperationRecord],
        localSources: [AssetSource],
        remoteAssets: [Asset],
        remoteRecords: [OperationRecord],
        remoteSources: [AssetSource]
    ) -> (assets: [Asset], records: [OperationRecord], sources: [AssetSource]) {
        // 合并策略：保留最新的资产，基于 lastUpdated 时间戳
        var mergedAssets = localAssets
        for remoteAsset in remoteAssets {
            if let localIndex = mergedAssets.firstIndex(where: { $0.id == remoteAsset.id }) {
                // 如果远程资产更新时间更晚，则使用远程版本
                if remoteAsset.lastUpdated > mergedAssets[localIndex].lastUpdated {
                    mergedAssets[localIndex] = remoteAsset
                }
            } else {
                // 如果本地没有此资产，则添加
                mergedAssets.append(remoteAsset)
            }
        }
        
        // 对操作记录使用类似策略，按时间排序
        var mergedRecords = Array(Set(localRecords + remoteRecords)) // 去重
        mergedRecords.sort { $0.timestamp > $1.timestamp } // 按时间倒序排列
        
        // 对来源也使用类似策略
        var mergedSources = localSources
        for remoteSource in remoteSources {
            if let localIndex = mergedSources.firstIndex(where: { $0.id == remoteSource.id }) {
                // 如果远程来源更新时间更晚，则使用远程版本
                if remoteSource.importDate > mergedSources[localIndex].importDate {
                    mergedSources[localIndex] = remoteSource
                }
            } else {
                // 如果本地没有此来源，则添加
                mergedSources.append(remoteSource)
            }
        }
        
        return (mergedAssets, mergedRecords, mergedSources)
    }
    
    // MARK: - Persistence
    
    private func loadSyncFolderPath() {
        if let path = UserDefaults.standard.string(forKey: "FileBasediCloudSyncPath") {
            syncFolderPath = path
            selectedFolderURL = URL(fileURLWithPath: path)
        }
    }
    
    // 保存 bookmark 数据
    func saveBookmarkData(_ url: URL) {
        do {
            // 使用适当的选项创建书签数据
            #if os(macOS)
            let options: URL.BookmarkCreationOptions = .withSecurityScope
            #else
            let options: URL.BookmarkCreationOptions = []
            #endif
            
            bookmarkData = try url.bookmarkData(
                options: options,
                includingResourceValuesForKeys: nil,
                relativeTo: nil
            )
            
            UserDefaults.standard.set(bookmarkData, forKey: "SyncFolderBookmark")
            print("✅ 已保存书签数据")
        } catch {
            print("❌ 保存书签数据失败: \(error.localizedDescription)")
        }
    }
    
    // 从 bookmark 数据恢复 URL
    func restoreURLFromBookmark() -> URL? {
        guard let data = bookmarkData ?? UserDefaults.standard.data(forKey: "SyncFolderBookmark") else {
            return nil
        }
        
        var isStale = false
        do {
            // 使用适当的选项解析书签数据
            #if os(macOS)
            let options: URL.BookmarkResolutionOptions = .withSecurityScope
            #else
            let options: URL.BookmarkResolutionOptions = []
            #endif
            
            let url = try URL(
                resolvingBookmarkData: data,
                options: options,
                relativeTo: nil,
                bookmarkDataIsStale: &isStale
            )
            
            if isStale {
                print("⚠️ 书签数据已过期，需要重新选择文件夹")
                return nil
            }
            
            #if os(macOS)
            // 在 macOS 上请求安全作用域访问
            let accessGranted = url.startAccessingSecurityScopedResource()
            if accessGranted {
                selectedFolderURL = url
                print("✅ 已从书签恢复 URL: \(url.path)")
                return url
            } else {
                print("❌ 无法获取书签 URL 的访问权限")
                return nil
            }
            #else
            // iOS 上不需要显式请求安全作用域访问
            selectedFolderURL = url
            print("✅ 已从书签恢复 URL: \(url.path)")
            return url
            #endif
        } catch {
            print("❌ 从书签恢复 URL 失败: \(error.localizedDescription)")
            return nil
        }
    }
    
    func saveSyncFolderPath(_ path: String) {
        syncFolderPath = path
        selectedFolderURL = URL(fileURLWithPath: path)
        UserDefaults.standard.set(path, forKey: "FileBasediCloudSyncPath")
    }
    
    func clearSyncFolderPath() {
        syncFolderPath = nil
        selectedFolderURL = nil
        UserDefaults.standard.removeObject(forKey: "FileBasediCloudSyncPath")
    }
    
    // MARK: - Status
    
    func getConnectionStatus() -> String {
        guard selectedFolderURL != nil else { return "未选择同步文件夹" }
        return "已连接到: \(syncFolderPath ?? "未知")"
    }
}

// MARK: - UIDocumentPickerDelegate

extension FileBasediCloudSyncService: UIDocumentPickerDelegate {
    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
        guard let selectedURL = urls.first else { return }
        
        // 保存 URL 引用
        selectedFolderURL = selectedURL
        
        // 保存书签数据
        saveBookmarkData(selectedURL)
        
        // 验证是否为文件夹
        var isDirectory: ObjCBool = false
        if fileManager.fileExists(atPath: selectedURL.path, isDirectory: &isDirectory) {
            if isDirectory.boolValue {
                saveSyncFolderPath(selectedURL.path)
                syncStatus = "已选择同步文件夹: \(selectedURL.lastPathComponent)"
                print("✅ 已选择同步文件夹: \(selectedURL.path)")
            } else {
                syncStatus = "请选择一个文件夹而不是文件"
                selectedURL.stopAccessingSecurityScopedResource()
            }
        } else {
            syncStatus = "无法访问所选位置"
            selectedURL.stopAccessingSecurityScopedResource()
        }
    }
    
    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
        syncStatus = "取消选择同步文件夹"
    }
}